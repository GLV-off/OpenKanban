# Environment variables for the service.
# Copy to .env for local development: the service loads it via dotenvy,
# and the process environment has priority over .env values.

# HTTP bind address.
OK_BIND=127.0.0.1:8080

# SQLite database URL. The file is created on startup; the parent directory must exist.
OK_DATABASE_URL=sqlite://open_kanban.db

# tracing EnvFilter directive.
OK_LOG=info,open_kanban_service=debug

# development | production. Production enables JSON logs and hides Swagger UI.
OK_ENV=development

# JWT signing secret (HS256). Required in production, at least 32 characters.
# Development falls back to a well-known insecure secret; never deploy with it.
# OK_JWT_SECRET=

# Access token lifetime (seconds) and refresh session lifetime (seconds).
OK_ACCESS_TTL_SECONDS=900
OK_REFRESH_TTL_SECONDS=2592000

# Browser origins allowed to call cookie-based auth endpoints (comma-separated).
OK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Secure cookie flag. Defaults to true when OK_ENV=production.
# OK_COOKIE_SECURE=false

# Failed login attempts per email inside a 15 minute window.
OK_LOGIN_MAX_ATTEMPTS=10
